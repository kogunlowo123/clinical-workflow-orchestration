{
  "$defs": {
    "FindingSource": {
      "enum": [
        "deterministic",
        "model-review"
      ],
      "title": "FindingSource",
      "type": "string"
    },
    "ModelProvenance": {
      "properties": {
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "cost_usd": {
          "title": "Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_digest": {
          "title": "Output Digest",
          "type": "string"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "request_ids": {
          "items": {
            "type": "string"
          },
          "title": "Request Ids",
          "type": "array"
        }
      },
      "required": [
        "provider",
        "model",
        "request_ids",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "attempts",
        "output_digest"
      ],
      "title": "ModelProvenance",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "completed",
        "unavailable"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "ValidationFinding": {
      "properties": {
        "activity_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Index"
        },
        "check": {
          "title": "Check",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "description": "Stable id: check plus subject; used to acknowledge the finding",
          "title": "Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source": {
          "$ref": "#/$defs/FindingSource"
        }
      },
      "required": [
        "id",
        "check",
        "severity",
        "source",
        "message"
      ],
      "title": "ValidationFinding",
      "type": "object"
    }
  },
  "$id": "https://github.com/kogunlowo123/clinical-workflow-orchestration/schemas/validation-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "draft_digest": {
      "title": "Draft Digest",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ValidationFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "review_model": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review_status": {
      "$ref": "#/$defs/ReviewStatus"
    },
    "review_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Summary"
    },
    "ruleset_version": {
      "title": "Ruleset Version",
      "type": "string"
    },
    "validated_at": {
      "format": "date-time",
      "title": "Validated At",
      "type": "string"
    }
  },
  "required": [
    "draft_digest",
    "ruleset_version",
    "findings",
    "review_status",
    "validated_at"
  ],
  "title": "ValidationReport",
  "type": "object"
}
